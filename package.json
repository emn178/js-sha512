{
  "name": "js-sha512",
  "version": "0.10.0",
  "description": "This is a simple SHA-512, SHA-384, SHA-512/224, SHA-512/256 hash functions for JavaScript supports UTF-8 encoding.",
  "main": "src/sha512.js",
  "module": "build/sha512.mjs",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./build/sha512.mjs",
      "require": "./src/sha512.js",
      "default": "./src/sha512.js"
    },
    "./src/sha512.js": "./src/sha512.js",
    "./build/sha512.min.js": "./build/sha512.min.js",
    "./build/sha512.mjs": "./build/sha512.mjs",
    "./build/sha512.min.mjs": "./build/sha512.min.mjs",
    "./package.json": "./package.json"
  },
  "types": "./index.d.ts",
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-terser": "^1.0.2",
    "expect.js": "~0.3.1",
    "mocha": "^12.0.3",
    "nyc": "^18.0.0",
    "requirejs": "^2.3.8",
    "rollup": "^4.65.0",
    "tiny-worker": "^2.3.0",
    "uglify-js": "^3.19.3"
  },
  "scripts": {
    "test": "npm run build && npm run test:coverage",
    "test:runtime": "mocha tests/node-test.js && mocha tests/esm-test.mjs",
    "test:coverage": "nyc --reporter=text --reporter=html --reporter=lcov npm run test:runtime",
    "report": "nyc --reporter=html --reporter=text npm run test:runtime",
    "build": "rollup -c && uglifyjs src/sha512.js -c -m eval --comments -o build/sha512.min.js",
    "prepack": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/emn178/js-sha512.git"
  },
  "keywords": [
    "sha",
    "sha2",
    "sha384",
    "sha512",
    "sha512/224",
    "sha512/256",
    "hash",
    "encryption",
    "cryptography",
    "HMAC"
  ],
  "license": "MIT",
  "author": "Chen, Yi-Cyuan <emn178@gmail.com>",
  "homepage": "https://github.com/emn178/js-sha512",
  "bugs": {
    "url": "https://github.com/emn178/js-sha512/issues"
  },
  "nyc": {
    "exclude": [
      "tests"
    ]
  },
  "overrides": {
    "glob": "^14.0.2",
    "minimatch": "^11.0.1"
  }
}
